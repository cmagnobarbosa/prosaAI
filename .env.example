# ProsaAI Environment Configuration
# Copy this file to .env and update the values

# =========================
# JWT Authentication (REQUIRED)
# =========================
# Secret key for signing JWT tokens - CHANGE THIS IN PRODUCTION!
SECRET_KEY=your-secret-key-here-change-in-production

# =========================
# OpenAI Configuration (OPTIONAL)
# =========================
# Primary LLM Provider
PROVIDER1=openai
PROVIDER1_API_KEY=your-openai-api-key-here
MODEL1=gpt-3.5-turbo

# Secondary LLM Provider  
PROVIDER2=openai
PROVIDER2_API_KEY=your-openai-api-key-here
MODEL2=gpt-3.5-turbo

# =========================
# Legacy Token (DEPRECATED)
# =========================
# This is kept for backwards compatibility but not used in JWT auth
# UAI_API_TOKEN=legacy-token-not-used-anymore